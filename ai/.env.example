AI_PORT=8001
# 생활비 예측 모델 폴더. 지정하지 않으면 저장소의 ai/models/living-cost
# AI_LIVING_COST_MODEL_DIR=C:\path\to\living-cost
# 신용 생활 소비 예측 모델 폴더. 지정하지 않으면 저장소의 ai/models/credit-spending
# AI_CREDIT_SPENDING_MODEL_DIR=C:\path\to\credit-spending
# 로컬에서 기본 API 문서(/docs)를 볼 때만 켠다. 운영에서는 넣지 않는다
# AI_DOCS_ENABLED=true
