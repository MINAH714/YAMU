pipeline {
    agent none
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
    }
    stages {
        stage('Test master') {
            steps {
                script {
                    def tested = build(job: 'yamu/ci-master', wait: true, propagate: true)
                    env.TESTED_BUILD = tested.number.toString()
                    echo "Candidate: yamu/ci-master #${env.TESTED_BUILD}"
                }
            }
        }
        stage('Approve production') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Deploy BE from ci-master #${env.TESTED_BUILD}? DB migration changes are rejected.",
                          ok: 'Deploy', submitter: 'yamu-release-managers', submitterParameter: 'APPROVER'
                }
            }
        }
        stage('Deploy and verify') {
            agent { label 'yamu-ci' }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'yamu-cd-trigger', keyFileVariable: 'CD_KEY')]) {
                    // The key is restricted server-side to one root-owned command.
                    sh '''set +x
                        set -eu
                        case "$TESTED_BUILD" in ''|*[!0-9]*) exit 2;; esac
                        ssh -o BatchMode=yes -o StrictHostKeyChecking=yes \
                          -o UserKnownHostsFile=/etc/yamu-cd/known_hosts \
                          -i "$CD_KEY" yamu-deploy@100.102.125.41 "$TESTED_BUILD"
                    '''
                }
            }
        }
    }
}
