# Non-secret development settings only. Actual secret files stay outside the repository.
YAMU_DEV_BACKEND_IMAGE=
YAMU_DEV_RDS_HOST=yamu-mysql.cl622ga6ai2l.ap-northeast-2.rds.amazonaws.com
YAMU_DEV_RDS_TRUSTSTORE_PATH=/opt/yamu/certs/rds-truststore.p12
YAMU_DEV_SECRETS_DIR=/home/ubuntu/.config/yamu/dev/secrets
# Proposed localhost-only port; confirm availability before an authorized deployment.
YAMU_DEV_HTTP_PORT=18080
