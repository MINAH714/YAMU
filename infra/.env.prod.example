# Copy only on the server to infra/.env.prod and restrict permissions.
# Generate separate random values for the two passwords. Do not use local defaults.
# Empty passwords intentionally prevent Compose from starting.
DB_NAME=yamu
DB_USERNAME=yamu
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Generate each independently with openssl rand -base64 32. Never commit real keys.
# Back up in the team's secret store before deployment; do not casually rotate crypto keys.
YAMU_CRYPTO_DATA_KEY_1=
YAMU_CRYPTO_HMAC_KEY=
YAMU_CRYPTO_PIN_PEPPER=
YAMU_JWT_SECRET=
# Use a commit identifier for each manually built deployment image.
APP_VERSION=manual
