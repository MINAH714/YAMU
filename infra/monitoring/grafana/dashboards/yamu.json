{
  "uid": "yamu-team",
  "title": "YAMU · API와 배포 모니터링",
  "tags": [
    "YAMU"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Seoul",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "수집 신선도 · 30초 이상이면 수집 확인",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yamu-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - yamu_collector_last_success_timestamp_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "yamu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "운영 BE 상태 · 1 정상 / 0 확인 필요",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yamu-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yamu_service_up{service=\"backend\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "yamu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "운영 AI 상태 · 1 정상 / 0 확인 필요",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "yamu-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yamu_service_up{service=\"ai\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "yamu-prometheus"
          }
