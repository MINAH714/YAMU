pipeline {
    agent { label 'yamu-ci' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timestamps()
    }
    parameters {
        string(name: 'MR_IID', defaultValue: '', description: 'Optional same-project MR number; blank scans oldest unchecked develop MR')
        booleanParam(name: 'RETRY', defaultValue: false, description: 'Manually retry a completed MR status; active statuses are never duplicated')
    }
    triggers { cron(env.JOB_NAME == 'yamu/gitlab/mr-ci' ? 'H/5 * * * *' : '') }
    environment {
        CI = 'true'
        TZ = 'UTC'
        NODE_OPTIONS = '--max-old-space-size=1024'
        VITE_API_BASE_URL = '/api'
        YAMU_MR_SELECTED = 'false'
    }
    stages {
        stage('Trusted control checkout') {
            steps {
                deleteDir()
                checkout scm
                sh 'python3 -m unittest discover -s infra/gitlab -p "test_*.py"'
            }
        }
        stage('Select MR source revision') {
            steps {
                script {
                    withEnv(["YAMU_MR_IID=${params.MR_IID.trim()}", "YAMU_RETRY_MR=${params.RETRY}"]) {
                        withCredentials([file(credentialsId: 'yamu-gitlab-status-api', variable: 'YAMU_GITLAB_API_FILE')]) {
                            def selected = sh(returnStdout: true, script: 'set +x; python3 infra/gitlab/status.py select').trim()
                            if (selected == 'selected') {
                                def ctx = new groovy.json.JsonSlurperClassic().parseText(readFile('gitlab-status/context.json'))
                                env.YAMU_PINNED_SHA = ctx.sha
                                env.YAMU_PINNED_REF = ctx.ref
                                env.YAMU_PINNED_IID = ctx.iid.toString()
                                env.YAMU_MR_SELECTED = 'true'
                                currentBuild.description = "MR !${ctx.iid} · ${ctx.sha.take(12)}"
                                withEnv(['YAMU_GITLAB_STATE=running']) {
                                    sh 'set +x; python3 infra/gitlab/status.py mr-report'
                                }
                            } else if (selected != 'none') {
                                error('Invalid MR selection result')
                            } else {
                                currentBuild.description = 'No unchecked eligible MR'
                            }
                        }
                    }
                }
            }
        }
        stage('Pinned candidate checkout') {
            when { environment name: 'YAMU_MR_SELECTED', value: 'true' }
            steps {
                dir('candidate') {
                    checkout([$class: 'GitSCM', branches: [[name: env.YAMU_PINNED_SHA]],
                        userRemoteConfigs: [[url: 'https://lab.ssafy.com/s15-final/S15P31E103.git', credentialsId: 'gitlab-yamu-read']],
                        extensions: []])
                }
                sh 'python3 infra/gitlab/candidate.py check'
                dir('candidate') { sh 'sh infra/ci/check-environment.sh' }
            }
        }
        stage('BE tests and JAR') {
            when { environment name: 'YAMU_MR_SELECTED', value: 'true' }
            steps {
                dir('candidate/be') {
                    sh 'sh ./gradlew --no-daemon --max-workers=1 -Dorg.gradle.jvmargs="-Xmx768m -XX:MaxMetaspaceSize=384m" clean test bootJar'
                }
                sh 'python3 infra/ci/check-test-results.py candidate/be/build/test-results/test'
            }
            post {
                always {
                    script {
                        if (env.YAMU_MR_SELECTED == 'true') {
                            junit testResults: 'candidate/be/build/test-results/test/TEST-*.xml', allowEmptyResults: false
                        }
                    }
                }
            }
        }
        stage('POS and Expo checks') {
            when { environment name: 'YAMU_MR_SELECTED', value: 'true' }
            steps {
                dir('candidate/fe/pos') { sh 'npm ci --no-audit --no-fund && npm run lint && npm run build' }
                dir('candidate/fe/mobile') { sh 'npm ci --no-audit --no-fund && ./node_modules/.bin/tsc --noEmit' }
            }
        }
        stage('Android customer tests and build') {
            when { environment name: 'YAMU_MR_SELECTED', value: 'true' }
            steps { sh 'python3 infra/gitlab/candidate.py android' }
            post {
                always {
                    script {
                        if (env.YAMU_MR_SELECTED == 'true') {
                            junit testResults: 'candidate/fe/android/app/build/test-results/testCustomerDebugUnitTest/TEST-*.xml', allowEmptyResults: false
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                if (env.YAMU_MR_SELECTED == 'true') {
                    def mapping = ['SUCCESS': 'success', 'FAILURE': 'failed', 'UNSTABLE': 'failed', 'ABORTED': 'canceled', 'NOT_BUILT': 'skipped']
                    def state = mapping[currentBuild.currentResult] ?: 'failed'
                    try {
                        withEnv(["YAMU_GITLAB_STATE=${state}"]) {
                            withCredentials([file(credentialsId: 'yamu-gitlab-status-api', variable: 'YAMU_GITLAB_API_FILE')]) {
                                sh 'set +x; python3 infra/gitlab/status.py mr-report'
                            }
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException interrupted) {
                        throw interrupted
                    } catch (Exception ignored) {
                        unstable('Final GitLab status delivery failed; inspect this Jenkins build before retrying.')
                    }
                    archiveArtifacts artifacts: 'gitlab-status/context.json', fingerprint: false
                }
            }
        }
        cleanup { deleteDir() }
    }
}
