<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 화면 색 · 글자는 Compose 테마(YamuTheme)가 정한다. 여기는 앱이 뜨기 전 창 바탕만(다크 모드 색은 values-night/colors.xml) -->
    <style name="Theme.YAMU" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/yamu_window</item>
    </style>

    <!-- 고객 앱 시작 화면 — 첫 화면(A-01 · A-03)을 정할 때까지 시스템 스플래시를 그대로 둔다(MainActivity · StartGate, S15P31E103-512) -->
    <style name="Theme.YAMU.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yamu_window</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.YAMU</item>
    </style>
</resources>
