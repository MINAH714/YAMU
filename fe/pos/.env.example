VITE_API_BASE_URL=/api

# 모의 POS 설정. 이 파일은 견본이고, 실제 값은 .env.local에 넣는다(.env.*는 커밋하지 않는다).
# POS 키는 BE application-local.yml의 yamu.pos.key와 같은 값이다.
# VITE_ 값은 브라우저 번들에 그대로 들어가므로 모의 POS 전용 키만 쓴다.
VITE_POS_KEY=
# BE application.yml의 yamu.pos.terminals[].pos-code 중 하나
VITE_POS_CODE=POS-STARBUCKS-GENERAL
# 위 posCode의 brand-code(STARBUCKS 등)에 해당하는 merchant.merchant_id
VITE_MERCHANT_ID=

# true면 결제 결과 조회(GET /api/pos/payment-requests/{paymentId})를 화면 안의 Mock으로 대신한다.
# POS 결제 결과 조회 API(S15P31E103-229)가 머지되면 false로 바꾼다. 결제 요청 생성은 항상 실제 BE를 부른다.
VITE_POS_MOCK_RESULT=true
