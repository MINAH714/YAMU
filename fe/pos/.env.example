VITE_API_BASE_URL=/api

# 모의 POS 설정. 이 파일은 견본이고, 실제 값은 .env.local에 넣는다(.env.*는 커밋하지 않는다).
# POS 키는 BE application-local.yml의 yamu.pos.key와 같은 값이다.
# VITE_ 값은 브라우저 번들에 그대로 들어가므로 모의 POS 전용 키만 쓴다.
VITE_POS_KEY=

# 매장별 단말. POS_CODE는 BE application.yml의 yamu.pos.terminals[].pos-code,
# MERCHANT_ID는 그 brand-code(STARBUCKS·GS25)에 해당하는 merchant.merchant_id다.
# 값이 빈 매장은 매장 선택 화면에서 고를 수 없다.
VITE_STARBUCKS_POS_CODE=POS-STARBUCKS-GENERAL
VITE_STARBUCKS_MERCHANT_ID=
VITE_GS25_POS_CODE=POS-GS25-GENERAL
VITE_GS25_MERCHANT_ID=

# true면 결제 결과 조회(GET /api/pos/payment-requests/{paymentId})를 화면 안의 Mock으로 대신한다.
# BE 없이 화면만 볼 때 쓴다. 결제 요청 생성은 항상 실제 BE를 부른다.
VITE_POS_MOCK_RESULT=false
