# Inject through the deployment secret manager or a private shell session. Never commit actual values.
YOONSEO_JDBC_URL=jdbc:mysql://HOST:3306/DATABASE?serverTimezone=UTC&characterEncoding=UTF-8&sslMode=VERIFY_IDENTITY
YOONSEO_DB_USERNAME=FILL
YOONSEO_DB_PASSWORD=FILL
YOONSEO_EXPECTED_DATABASE=FILL
YOONSEO_SEED_MAINTENANCE=true
# Same crypto values as the target server, NOT local test keys.
YAMU_CRYPTO_DATA_KEY_ID=1
YAMU_CRYPTO_DATA_KEY_1=FILL_BASE64
YAMU_CRYPTO_HMAC_KEY=FILL_BASE64
YAMU_CRYPTO_PIN_PEPPER=FILL_BASE64
SSAFY_API_BASE_URL=https://finopenapi.ssafy.io/ssafy/api/v1
SSAFY_API_KEY=FILL
# Only the separate bank preparation command uses this flag.
YOONSEO_PREPARE_BANK=true
