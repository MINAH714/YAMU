# 로컬 개발용 설정 견본.
# 같은 폴더에 application-local.yml로 복사해서 쓴다. 복사본은 깃에 올라가지 않는다(be/.gitignore).
# 기본값은 be/docker-compose.yml의 기본값과 같아서, 복사만 하면 바로 붙는다.
# be/.env로 포트·비밀번호를 바꿨다면 아래 기본값(: 뒤의 값)도 같이 바꾼다.
spring:
  datasource:
    url: jdbc:mysql://localhost:${DB_PORT:3306}/${DB_NAME:yamu}?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: ${DB_USERNAME:yamu}
    password: ${DB_PASSWORD:yamu_local}
  data:
    redis:
      host: localhost
      port: ${REDIS_PORT:6379}

management:
  endpoint:
    health:
      # 로컬에서만 /actuator/health에 DB·Redis 연결 상태를 자세히 보여준다.
      show-details: always
