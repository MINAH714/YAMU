# 로컬 개발용 설정 견본.
# 같은 폴더에 application-local.yml로 복사해서 쓴다. 복사본은 깃에 올라가지 않는다(be/.gitignore).
# 기본값은 be/docker-compose.yml의 기본값과 같아서, 복사만 하면 바로 붙는다.
# be/.env로 포트·비밀번호를 바꿨다면 아래 기본값(: 뒤의 값)도 같이 바꾼다.
spring:
  datasource:
    url: jdbc:mysql://localhost:${DB_PORT:3306}/${DB_NAME:yamu}?serverTimezone=UTC&characterEncoding=UTF-8
    username: ${DB_USERNAME:yamu}
    password: ${DB_PASSWORD:yamu_local}
  data:
    redis:
      host: localhost
      port: ${REDIS_PORT:6379}

management:
  endpoint:
    health:
      # 로컬에서만 /actuator/health에 DB·Redis 연결 상태를 자세히 보여준다.
      show-details: always

# 개인정보 암호화 키(로컬 전용). 비어 있으면 서버가 뜨지 않는다.
# Seed를 실행한 PowerShell에서 bootRun하면 아래 환경변수로 같은 키를 사용한다.
# Seed 없이 실행하면 환경변수를 설정하거나 각 값을 직접 입력한다. 키는 서로 달라야 한다.
# 키를 바꾸면 로컬 DB에 이미 넣은 암호문·해시가 맞지 않으니 `docker compose down -v`로 초기화한다.
# 자세한 내용: docs/be/personal-data-crypto.md
yamu:
  crypto:
    data-key-id: ${YAMU_CRYPTO_DATA_KEY_ID:1}
    data-keys:
      "[1]": ${YAMU_CRYPTO_DATA_KEY_1:}
    hmac-key: ${YAMU_CRYPTO_HMAC_KEY:}
    pin-pepper: ${YAMU_CRYPTO_PIN_PEPPER:}
  # Access Token 서명 키(로컬 전용). `openssl rand -base64 32` 결과를 넣는다.
  jwt:
    secret: ${YAMU_JWT_SECRET:}
  # SSAFY 금융망 팀 공용 앱 키. 값은 노션 API 명세 4장에 있다. 금융망을 부르지 않는 작업이면 비워 둬도 된다.
  fin-api:
    api-key:
  # 공공데이터포털 「한국천문연구원_특일 정보」 디코딩 키(본인 계정으로 발급). 비워 두면 공휴일 동기화 없이 내장 파일로만 영업일을 센다.
  holiday:
    service-key: ${DATA_GO_KR_SERVICE_KEY:}
  # 모의 POS 웹(fe/pos)이 보내는 X-POS-Key. 로컬 전용 값이며 fe/pos의 .env에도 같은 값을 넣는다. 비워 두면 POS 결제 요청이 401이다.
  # 데모용 인증: fe/pos는 브라우저 앱이라 이 키가 빌드된 JS에 그대로 들어간다. 키는 하나이고 posCode와 묶이지 않으며 호출 횟수 제한도 없다.
  pos:
    key: ${YAMU_POS_KEY:local-pos-key}
  # 운영 API(정기 작업 수동 실행)의 X-Admin-Key. 로컬 전용 값. 비워 두면 운영 API가 403이다.
  admin:
    key: ${YAMU_ADMIN_KEY:local-admin-key}
